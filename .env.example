# Optional: the app remains usable in local demo mode without any credentials.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
DATABASE_URL=postgres://postgres:your-database-password@db.your-project.supabase.co:5432/postgres?sslmode=require

# Server-side model provider credentials. Never add NEXT_PUBLIC_ to these keys.
QUATRE_GATEWAY_URL=https://your-gateway.example.com
QUATRE_GATEWAY_API_KEY=replace-me
OPENAI_API_KEY=replace-me
ANTHROPIC_API_KEY=replace-me
GOOGLE_AI_API_KEY=replace-me
XAI_API_KEY=replace-me
